# PERSONAL OS ENVIRONMENT VARIABLES

# SUPABASE CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WEBAUTHN / PASSKEY CONFIGURATION
# Production: WEBAUTHN_RP_ID=your-domain.com, WEBAUTHN_ORIGIN=https://your-domain.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# GEMINI AI CONFIGURATION (Phase 7+)
GEMINI_API_KEY=your-gemini-api-key

# AUTOMATION & WEBHOOKS (n8n Cloud Phase 13+)
N8N_WEBHOOK_SECRET=your-32-character-webhook-secret-key

# APP CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
